<header class="site-header">
  <div class="site-container flex h-16 items-center justify-between gap-6 sm:h-20">
    <a href="/" class="shrink-0">
      <span class="logo-crop" aria-label="MTC Studio">
        <img src="/images/mtc-studio.png" alt="MTC Studio" />
      </span>
    </a>

    <nav class="hidden items-center gap-4 xl:flex" aria-label="Main navigation">
      <a href="/" class="nav-link <%= page === 'home' ? 'is-active' : '' %>">Home</a>
      <a href="/about" class="nav-link <%= page === 'about' ? 'is-active' : '' %>">About</a>
      <a href="/portfolio" class="nav-link <%= page === 'portfolio' ? 'is-active' : '' %>">Portfolio</a>
      <details class="group relative">
        <summary class="nav-link flex cursor-pointer list-none items-center gap-2 <%= ['image-compressor', 'image-converter', 'remove-background', 'passport-ratio'].includes(page) ? 'is-active' : '' %>">Image Tools <span aria-hidden="true" class="text-[10px] transition group-open:rotate-180">▼</span></summary>
        <div class="absolute left-0 top-full z-50 mt-2 grid min-w-52 gap-1 rounded-md border border-white/10 bg-dawn-950 p-2 shadow-xl">
          <a href="/image-compressor" class="nav-link rounded px-3 py-2 <%= page === 'image-compressor' ? 'is-active' : '' %>">Image Compressor</a>
          <a href="/image-converter" class="nav-link rounded px-3 py-2 <%= page === 'image-converter' ? 'is-active' : '' %>">Image Converter</a>
          <a href="/remove-background" class="nav-link rounded px-3 py-2 <%= page === 'remove-background' ? 'is-active' : '' %>">Remove Background</a>
          <a href="/passport-ratio" class="nav-link rounded px-3 py-2 <%= page === 'passport-ratio' ? 'is-active' : '' %>">Passport Ratio</a>
        </div>
      </details>
      <a href="/contact" class="nav-link <%= page === 'contact' ? 'is-active' : '' %>">Contact</a>
      <a href="/contact" class="btn-gold rounded-md !px-5 !py-2.5">Book a session</a>
    </nav>

    <button class="rounded-full border border-white/20 p-1.5 text-white xl:hidden sm:p-2" aria-label="Toggle menu" data-mobile-nav-toggle>
      <svg viewBox="0 0 24 24" class="h-5 w-5 fill-none stroke-current sm:h-6 sm:w-6" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <nav class="hidden border-t border-white/10 bg-dawn-950 px-5 py-5 xl:hidden" aria-label="Mobile navigation" data-mobile-nav>
    <a href="/" class="block border-b border-white/10 py-3 text-sm font-semibold uppercase tracking-[.18em] text-white">Home</a>
    <a href="/about" class="block border-b border-white/10 py-3 text-sm font-semibold uppercase tracking-[.18em] text-white">About</a>
    <a href="/portfolio" class="block border-b border-white/10 py-3 text-sm font-semibold uppercase tracking-[.18em] text-white">Portfolio</a>
    <details class="border-b border-white/10">
      <summary class="flex cursor-pointer list-none items-center justify-between py-3 text-sm font-semibold uppercase tracking-[.18em] text-white">Image Tools <span aria-hidden="true" class="text-[10px]">▼</span></summary>
      <div class="grid gap-1 pb-3 pl-4">
        <a href="/image-compressor" class="block py-2 text-xs font-semibold uppercase tracking-[.14em] text-dawn-200">Image Compressor</a>
        <a href="/image-converter" class="block py-2 text-xs font-semibold uppercase tracking-[.14em] text-dawn-200">Image Converter</a>
        <a href="/remove-background" class="block py-2 text-xs font-semibold uppercase tracking-[.14em] text-dawn-200">Remove Background</a>
        <a href="/passport-ratio" class="block py-2 text-xs font-semibold uppercase tracking-[.14em] text-dawn-200">Passport Ratio</a>
      </div>
    </details>
    <a href="/contact" class="block py-3 text-sm font-semibold uppercase tracking-[.18em] text-white">Contact</a>
  </nav>
</header>
