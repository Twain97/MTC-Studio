<%- include('../partials/head', { title, bodyClass: 'min-h-screen bg-dawn-50 text-dawn-950' }) %>
<%- include('../partials/site-header', { page }) %>
<main>
  <section class="page-hero">
    <div class="site-container relative z-10 py-[4.25rem] text-center md:py-[2.8rem]">
      <p class="eyebrow text-gold-300">Selected stories</p>
      <h1 class="mt-4 font-display text-4xl font-semibold text-white md:text-6xl">Portfolio</h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-8 text-dawn-100">Weddings, portraits, celebrations, and commercial stories photographed with clarity and warmth.</p>
    </div>
  </section>
  <section class="portfolio section-pad bg-dawn-50">
    <div class="site-container">
      <div data-portfolio-grid class="grid grid-flow-dense grid-cols-2 auto-rows-[9rem] gap-3 sm:auto-rows-[10rem] sm:gap-4 lg:grid-cols-6 lg:auto-rows-[10rem] lg:gap-5">
        <% projects.forEach((project, index) => { %>
          <article data-reveal="<%= index % 6 * 70 %>" class="portfolio-card group relative min-h-0 rounded-md <%= index % 6 === 0 ? 'col-span-2 row-span-2 lg:col-span-2 lg:row-span-2' : index % 6 === 3 ? 'col-span-2 row-span-1 lg:col-span-2' : index % 6 === 5 ? 'col-span-1 row-span-2 lg:col-span-1 lg:row-span-2' : 'col-span-1 row-span-1 lg:col-span-1' %>">
            <img src="<%= project.thumbnail %>" alt="<%= project.eventName %> photography in <%= project.location %> by MTC Studio" class="absolute inset-0 h-full w-full object-cover transition duration-700" loading="lazy" decoding="async" data-fallback-src="/images/photographer.webp" />
            <div class="absolute inset-0 bg-gradient-to-t from-dawn-950/90 via-dawn-950/10 to-transparent"></div>
            <a href="/portfolio/<%= project._id %>" data-project-link class="absolute inset-0 z-10" aria-label="View <%= project.eventName %> project"></a>
            <div class="pointer-events-none absolute inset-x-0 bottom-0 z-10 p-4 text-white sm:p-5">
              <h2 class="font-display text-xl font-semibold leading-tight sm:text-2xl"><%= project.eventName %></h2>
              <div class="mt-2 flex flex-wrap items-center justify-between gap-x-3 gap-y-1 text-[10px] font-semibold uppercase tracking-[.12em] text-white/80 sm:text-xs">
                <span><%= new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric' }).format(new Date(project.eventDate)) %></span>
                <span><%= project.location %></span>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </div>
  </section>
</main>
<%- include('../partials/site-footer') %>
<%- include('../partials/whatsapp', { whatsappNumber }) %>
<%- include('../partials/site-scripts') %>
