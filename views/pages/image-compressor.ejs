<%- include('../partials/head', { title, bodyClass: 'min-h-screen bg-dawn-50 text-dawn-950' }) %>
<%- include('../partials/site-header', { page }) %>
<main>
  <section class="bg-dawn-900 py-2 text-white sm:py-4 md:py-3">
    <div class="site-container">
      <h1 class="section-title mt-2 !text-2xl text-white sm:!text-2xl lg:!text-[30px]">Image Compressor</h1>
      <p class="mt-2 max-w-2xl text-sm leading-7 text-dawn-200 sm:mt-5 md:text-base">Resize image files into a format that suits your needs. Images are processed in your browser and are not uploaded.</p>
    </div>
  </section>

  <section class="section-pad lg:pt-6">
    <div class="site-container mx-auto max-w-4xl">
      <div class="grid gap-8 rounded-md border border-dawn-200 bg-white p-5 shadow-sm sm:p-8">
        <label class="upload-box rounded-md" data-drop-zone>
          <input class="sr-only" type="file" accept=".jpg,.jpeg,.png,.webp,.raw,.cr2,.cr3,.nef,.nrw,.arw,.srf,.sr2,.dng,.raf,.orf,.rw2,.pef,.ptx,.srw,.3fr,.fff,.iiq,.kdc,.dcr,.mos,.mrw,.x3f,.rwl,.cap,.eip,image/jpeg,image/png,image/webp" multiple data-compressor-files />
          <strong>Drop images here or choose files</strong>
          <span>JPG and WebP. PNG and camera RAW files can be converted with the Image Converter. Up to 10 images at a time, 20 MB maximum per image.</span>
        </label>
        <label class="grid gap-2 text-xs font-bold uppercase tracking-[.12em] text-dawn-700" data-quality-control>
          Quality <span class="flex items-center gap-3"><input class="w-full accent-gold-500" type="range" min="0" max="100" value="82" data-compressor-quality /><output class="w-12 text-right text-sm" data-quality-value>82%</output></span>
          <span class="flex justify-between text-[10px] font-semibold normal-case tracking-normal text-dawn-600"><span>0% · Low size, low quality</span><span>100% · High quality, larger size</span></span>
          <span class="text-xs font-normal normal-case leading-5 tracking-normal text-dawn-500">Lower quality generally means smaller files. This setting applies to JPG and WebP images.</span>
        </label>
        <p class="text-sm text-red-700" role="alert" aria-live="polite" data-compressor-error></p>
        <div class="flex flex-wrap gap-3">
          <button class="btn-dark rounded-md" type="button" data-compress disabled>Compress images</button>
          <button class="btn-outline-dark rounded-md hidden" type="button" data-download-all>Download all</button>
          <button class="btn-outline-dark rounded-md hidden" type="button" data-clear-images>Clear images</button>
        </div>
        <div class="hidden items-center gap-3 text-sm text-dawn-700" role="status" aria-live="polite" data-compress-progress>
          <span class="inline-block h-5 w-5 animate-spin rounded-full border-2 border-dawn-300 border-t-gold-500" aria-hidden="true"></span>
          <span data-compress-progress-label>Preparing images…</span>
        </div>
        <div class="grid gap-4" aria-live="polite" data-compressor-results></div>
        <p class="text-xs leading-5 text-dawn-500">Compressed JPG and WebP images keep their original type. Lower quality settings may reduce image detail.</p>
        <p class="flex items-start gap-2 text-xs leading-5 text-red-700" role="note"><span class="warning-icon-x mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-red-700 text-[10px] font-bold" aria-hidden="true">!</span><span><strong>Privacy:</strong> Uploaded images and compressed results stay in this browser on your device, survive refreshes, and are cleared after 30 minutes or when you clear them. Downloaded files stay on your device.</span></p>
      </div>
    </div>
  </section>
  <div class="fixed inset-0 z-50 hidden place-items-center bg-dawn-950/60 p-4" role="alertdialog" aria-modal="true" aria-labelledby="compressor-warning-title" aria-describedby="compressor-warning-message" data-compressor-warning>
    <div class="w-full max-w-md rounded-md border border-dawn-200 bg-white p-6 shadow-xl">
      <h2 class="text-xl font-bold text-dawn-950" id="compressor-warning-title">Image cannot be compressed here</h2>
      <p class="mt-3 text-sm leading-6 text-dawn-700" id="compressor-warning-message" data-compressor-warning-message></p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn-gold rounded-md" href="/image-converter">Convert Picture</a>
        <button class="btn-outline-dark rounded-md" type="button" data-close-compressor-warning>Close</button>
      </div>
    </div>
  </div>
  <div class="pointer-events-none fixed inset-x-4 bottom-5 z-50 mx-auto hidden max-w-md rounded-md border border-red-200 bg-white px-5 py-4 text-sm font-semibold text-red-800 shadow-xl" role="status" aria-live="polite" data-compressor-toast></div>
</main>
<%- include('../partials/site-footer') %>
<%- include('../partials/whatsapp', { whatsappNumber }) %>
<script type="module" src="/js/image-compressor.js"></script>
<%- include('../partials/site-scripts') %>
