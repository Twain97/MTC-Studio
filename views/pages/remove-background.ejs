<%- include('../partials/head', { title, bodyClass: 'min-h-screen bg-dawn-50 text-dawn-950' }) %>
<%- include('../partials/site-header', { page }) %>
<main>
  <section class="bg-dawn-900 py-2 text-white sm:py-4 md:py-3">
    <div class="site-container flex items-center justify-between gap-4">
      <h1 class="section-title mt-2 !text-2xl text-white sm:!text-2xl lg:!text-[30px]">Remove Image Background</h1>
      <div class="hidden shrink-0 items-center gap-2 text-right" role="status" aria-live="polite" data-background-model-loading>
        <span class="max-w-40 text-[10px] font-semibold leading-tight text-dawn-100 sm:max-w-56 sm:text-xs" data-background-model-loading-label>First-time model loading. Please wait.</span>
        <svg class="h-9 w-9 shrink-0" viewBox="0 0 36 36" role="progressbar" aria-label="Background removal model download progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-background-model-loading-ring>
          <circle cx="18" cy="18" r="15.5" fill="none" stroke="currentColor" stroke-opacity=".25" stroke-width="3" />
          <circle cx="18" cy="18" r="15.5" fill="none" stroke="#d4a94f" stroke-linecap="round" stroke-width="3" stroke-dasharray="100" stroke-dashoffset="100" transform="rotate(-90 18 18)" data-background-model-loading-circle />
        </svg>
        <span class="min-w-8 text-xs font-bold tabular-nums text-white" data-background-model-loading-percent>0%</span>
        <button class="hidden text-xs font-bold text-white underline" type="button" data-background-model-retry>Retry</button>
      </div>
    </div>
  </section>

  <section class="section-pad lg:pt-6">
    <div class="site-container mx-auto max-w-5xl">
      <figure class="mb-2">
        <div class="relative mx-auto aspect-[3/2] w-1/2 overflow-hidden rounded-md border border-dawn-200 bg-white shadow-sm lg:w-[30%]" data-background-demo>
          <img class="absolute inset-0 h-full w-full object-cover" src="/images/background-demo-before.webp" alt="Portrait before background removal, with a green park behind the subject." data-background-demo-before />
          <img class="absolute inset-0 h-full w-full object-cover" src="/images/background-demo-after.webp" alt="The same portrait isolated against a transparency checkerboard after background removal." style="clip-path: inset(0 0 0 50%)" data-background-demo-after />
          <div class="absolute inset-y-0 left-1/2 z-10 w-0.5 -translate-x-1/2 bg-white shadow" style="left: 50%" data-background-demo-divider aria-hidden="true"><span class="absolute left-1/2 top-1/2 h-8 w-8 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white bg-dawn-950/70"></span></div>
          <span class="absolute bottom-3 left-3 z-20 rounded bg-dawn-950/75 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[.14em] text-white">Before</span>
          <span class="absolute bottom-3 right-3 z-20 rounded bg-dawn-950/75 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[.14em] text-white">After</span>
        </div>
        <figcaption class="px-4 pb-3 pt-2 text-center text-xs text-dawn-600">Example of a portrait with its background removed.</figcaption>
      </figure>
      <p class="mb-4 text-sm text-center leading-7 text-dawn-700">Remove the background from a JPG, PNG, or WebP image. Processing happens in your browser, and your image is not uploaded.</p>
      <div class="grid gap-3 rounded-md border border-dawn-200 bg-white p-3 shadow-sm sm:p-5">
        <label class="upload-box background-upload-box rounded-md" data-background-drop-zone>
          <input class="sr-only" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp" data-background-file />
          <strong>Drop an image here or choose a file</strong>
          <span>JPG, PNG, or WebP. Maximum file size: 20 MB.</span>
        </label>

        <div class="hidden items-center gap-4 rounded-md border border-dawn-200 bg-dawn-50 p-3" data-background-source-preview>
          <img class="h-16 w-16 rounded object-cover" alt="Selected image thumbnail preview" data-background-source-thumbnail />
          <div class="min-w-0">
            <p class="text-xs font-bold uppercase tracking-wide text-dawn-700">Selected image</p>
            <p class="mt-1 break-all text-sm text-dawn-600" data-background-source-name></p>
          </div>
        </div>

        <div class="hidden animate-pulse rounded-md border border-dawn-200 bg-dawn-50 p-6" aria-hidden="true" data-background-skeleton>
          <div class="grid min-h-40 content-center gap-4">
            <span class="mx-auto block h-5 w-2/3 rounded bg-dawn-200"></span>
            <span class="mx-auto block h-3 w-1/2 rounded bg-dawn-100"></span>
            <span class="mx-auto block h-3 w-3/5 rounded bg-dawn-100"></span>
            <span class="mx-auto block text-center text-xs font-semibold text-dawn-600" data-background-progress>Fetching Subject</span>
          </div>
        </div>

        <div class="flex flex-wrap gap-3">
          <button class="btn-dark rounded-md" type="button" disabled data-remove-background>Remove background</button>
          <a class="btn-gold hidden rounded-md" data-background-download>Download original result</a>
          <button class="btn-outline-dark hidden rounded-md" type="button" data-background-clear>Clear image</button>
        </div>

        <button class="hidden w-full rounded-md border border-dawn-200 bg-dawn-50 p-4 text-left transition hover:border-dawn-400 hover:bg-white focus:outline-none focus:ring-2 focus:ring-gold-500 sm:p-5" type="button" data-background-edit-open>
          <span class="flex items-center justify-between gap-4"><span><span class="block font-semibold text-dawn-900">Edit Result</span><span class="mt-1 block text-sm text-dawn-600">Erase, crop, or restore parts of the result.</span></span>
            <span class="flex shrink-0 items-center gap-3 rounded-md bg-dawn-900 px-4 py-2 text-sm font-semibold text-white">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m4 16 9.5-9.5a2.1 2.1 0 0 1 3 3L7 19H4v-3Zm10.5-10.5 4 4M4 21h16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3v14a2 2 0 0 0 2 2h12M3 7h14a2 2 0 0 1 2 2v12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg><span>Edit</span>
            </span>
          </span>
        </button>

        <section aria-label="Before and after comparison" class="hidden grid gap-3 lg:mx-auto lg:w-full lg:max-w-[46rem]" data-background-comparison>
          <div class="flex justify-between text-xs font-semibold text-dawn-700" aria-hidden="true"><span>Before</span><span>After</span></div>
          <div class="relative grid aspect-[4/3] min-h-64 place-items-center overflow-hidden rounded-md border border-dawn-200 bg-dawn-50 sm:aspect-[16/10] sm:min-h-80 lg:min-h-0">
            <img class="absolute inset-0 hidden h-full w-full object-contain" alt="Original uploaded image before background removal" data-background-before />
            <img class="absolute inset-0 hidden h-full w-full object-contain" alt="Model output with the background removed" data-background-after />
            <button class="absolute inset-y-0 left-1/2 z-10 hidden w-10 -translate-x-1/2 cursor-ew-resize touch-none flex items-center justify-center border-0 bg-transparent p-0 disabled:cursor-not-allowed" type="button" role="slider" aria-label="Drag to compare the original and background-removed image" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" aria-orientation="horizontal" disabled data-background-divider>
              <span class="pointer-events-none absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-white shadow" aria-hidden="true"></span>
              <span class="pointer-events-none relative flex h-10 w-10 items-center justify-center rounded-full border-2 border-white bg-dawn-950/80 text-white shadow" aria-hidden="true">
                <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none"><path d="M7 4 3 10l4 6M13 4l4 6-4 6M3 10h14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" /></svg>
              </span>
            </button>
            <div class="absolute inset-0 hidden animate-pulse bg-white/90 p-6" aria-hidden="true">
              <div class="grid h-full content-center gap-4">
                <span class="mx-auto block h-5 w-2/3 rounded bg-dawn-200"></span>
                <span class="mx-auto block h-3 w-1/2 rounded bg-dawn-100"></span>
                <span class="mx-auto block h-3 w-3/5 rounded bg-dawn-100"></span>
                <span class="mx-auto block text-center text-xs font-semibold text-dawn-600" data-background-progress>Fetching Subject</span>
              </div>
            </div>
          </div>
        </section>

        <div class="fixed inset-0 z-40 hidden bg-dawn-950/70" data-background-editor-overlay>
        <section class="mx-auto flex h-full w-full flex-col gap-3 overflow-hidden bg-white p-3 sm:gap-4 sm:p-5 lg:my-6 lg:h-[calc(100vh-3rem)] lg:max-w-6xl lg:rounded-lg lg:border lg:border-dawn-200 lg:shadow-2xl" data-background-editor aria-label="Edit background removal result" role="dialog" aria-modal="true" aria-labelledby="background-editor-title">
          <header class="flex shrink-0 items-center justify-between gap-3">
            <div>
              <h2 class="text-lg font-bold text-dawn-950" id="background-editor-title">Edit Result</h2>
              <p class="text-xs leading-5 text-dawn-600">Erase, crop, restore, or reposition your result.</p>
            </div>
            <button class="btn-outline-dark rounded-md px-3 py-2" type="button" aria-label="Close image editor" data-background-edit-close>Close</button>
          </header>
          <div class="flex flex-wrap items-center gap-2">
            <div class="relative hidden" data-background-download-format-control>
              <button class="btn-gold rounded-md px-3 py-2 text-xs" type="button" aria-expanded="false" aria-controls="background-download-formats" data-background-edited-download>Download edited image</button>
              <div class="pointer-events-none absolute left-0 top-full z-20 mt-2 grid max-h-0 w-52 -translate-y-1 gap-2 overflow-hidden rounded-md border border-dawn-200 bg-white p-0 opacity-0 shadow-lg transition-all duration-200 ease-out" id="background-download-formats" aria-hidden="true" data-background-download-formats>
                <div><button class="w-full rounded-md bg-gold-500 px-3 py-2 text-xs font-semibold text-dawn-950" type="button" data-background-download-format="image/png">PNG <span class="font-normal" data-download-size="image/png"></span></button><p class="mt-1 px-1 text-[10px] leading-4 text-dawn-600">High Quality, transparent background</p></div>
                <div><button class="w-full rounded-md bg-gold-200 px-3 py-2 text-xs font-semibold text-dawn-700" type="button" disabled>JPEG <span class="font-normal">(unavailable)</span> <span class="font-normal" data-download-size="image/jpeg"></span></button><p class="mt-1 px-1 text-[10px] leading-4 text-dawn-600">Medium size. Does not support transparency.</p></div>
                <div><button class="w-full rounded-md bg-gold-200 px-3 py-2 text-xs font-semibold text-dawn-700" type="button" disabled>WebP <span class="font-normal">(unavailable)</span> <span class="font-normal" data-download-size="image/webp"></span></button><p class="mt-1 px-1 text-[10px] leading-4 text-dawn-600">Smallest size. Optimize for websites and fast loading.</p></div>
              </div>
            </div>
            <button class="order-first btn-outline-dark rounded-md p-2" type="button" aria-label="Undo last edit" title="Undo" disabled data-background-undo>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 8V4m0 4h4M4.5 8A8 8 0 1 1 4 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" /></svg>
            </button>
            <button class="order-first btn-outline-dark rounded-md p-2" type="button" aria-label="Redo last undone edit" title="Redo" disabled data-background-redo>
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 8V4m0 4h-4m3.5 0A8 8 0 1 0 20 12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" /></svg>
            </button>
            <div class="ml-auto flex items-center gap-1" role="group" aria-label="Zoom edited image">
              <button class="btn-outline-dark rounded-md px-2 py-1 text-lg leading-none" type="button" aria-label="Zoom out" title="Zoom out" data-background-zoom-out>−</button>
              <output class="w-12 text-center text-xs tabular-nums text-dawn-700" data-background-zoom-value>100%</output>
              <button class="btn-outline-dark rounded-md px-2 py-1 text-lg leading-none" type="button" aria-label="Zoom in" title="Zoom in" data-background-zoom-in>+</button>
            </div>
          </div>
          <div class="flex min-h-0 flex-1 gap-3 overflow-hidden">
          <div class="background-editor-viewport relative min-h-0 min-w-0 flex-1 overflow-auto rounded-md border border-dawn-200" data-background-editor-viewport>
            <canvas class="block h-auto w-full touch-none" aria-label="Editable background removal result. Draw to erase or restore pixels." data-background-edit-canvas></canvas>
            <div class="pointer-events-none absolute hidden border-2 border-dashed border-white shadow-[0_0_0_9999px_rgba(15,23,42,0.45)] ring-2 ring-gold-400" data-background-crop-selection></div>
          </div>
          <aside class="flex w-40 shrink-0 flex-col gap-3 overflow-y-auto rounded-md border border-dawn-200 bg-dawn-50 p-2 sm:w-56 sm:p-3" aria-label="Edit Tools">
            <h3 class="text-sm font-bold text-dawn-900">Edit Tools</h3>
            <label class="grid gap-2 text-xs font-semibold text-dawn-700"><span>Brush size</span><input class="w-full accent-gold-500" type="range" min="8" max="240" value="120" data-background-brush-size /><output class="tabular-nums" data-background-brush-size-value>120 px</output></label>
            <div class="grid grid-cols-2 gap-2" role="group" aria-label="Edit tools">
              <div><button class="flex w-full flex-col items-center gap-1 rounded-md bg-dawn-900 px-1 py-2 text-center text-xs font-semibold text-white" type="button" aria-pressed="true" data-background-tool="erase"><svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m4 16 9.5-9.5a2.1 2.1 0 0 1 3 3L7 19H4v-3Zm10.5-10.5 4 4M4 21h16" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>Eraser</button><p class="hidden mt-1 px-1 text-xs leading-4 text-dawn-600" data-tool-description="erase">Erase unwanted result pixels.</p></div>
              <div><button class="flex w-full flex-col items-center gap-1 rounded-md border border-dawn-300 bg-white px-1 py-2 text-center text-xs font-semibold text-dawn-800" type="button" aria-pressed="false" data-background-tool="crop"><svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 3v14a2 2 0 0 0 2 2h12M3 7h14a2 2 0 0 1 2 2v12" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>Crop</button><p class="hidden mt-1 px-1 text-xs leading-4 text-dawn-600" data-tool-description="crop">Select the image area to keep.</p></div>
              <div><button class="flex w-full flex-col items-center gap-1 rounded-md border border-dawn-300 bg-white px-1 py-2 text-center text-xs font-semibold text-dawn-800" type="button" aria-pressed="false" data-background-tool="restore"><svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12a8 8 0 1 0 2.3-5.6L4 8.5M4 4v4.5h4.5M12 8v4l3 2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>Restore</button><p class="hidden mt-1 px-1 text-xs leading-4 text-dawn-600" data-tool-description="restore">Restore pixels from the original result.</p></div>
              <div><button class="flex w-full flex-col items-center gap-1 rounded-md border border-dawn-300 bg-white px-1 py-2 text-center text-xs font-semibold text-dawn-800" type="button" aria-pressed="false" data-background-tool="neutral" aria-label="Drag image" title="Drag image"><svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 11V5a2 2 0 0 1 4 0v5-6a2 2 0 0 1 4 0v7-5a2 2 0 0 1 4 0v8c0 4-2 7-6 7h-2c-2 0-3-1-4-2l-4-4a2 2 0 0 1 3-3l2 2" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7"/></svg>Drag</button><p class="hidden mt-1 px-1 text-xs leading-4 text-dawn-600" data-tool-description="neutral">Pan the zoomed image.</p></div>
            </div>
            <div class="border-t border-dawn-200 pt-3" role="group" aria-label="Background color">
              <h4 class="mb-2 text-xs font-semibold text-dawn-700">Background</h4>
              <div class="grid grid-cols-2 gap-2">
                <button class="flex flex-col items-center gap-1 rounded-md border border-gold-500 bg-white p-2 text-[10px] font-semibold text-dawn-800" type="button" aria-pressed="true" data-background-color="transparent"><span class="h-5 w-5 rounded-full border border-dawn-300 bg-[conic-gradient(#d1d5db_25%,white_0_50%,#d1d5db_0_75%,white_0)] bg-[length:8px_8px]"></span>Transparent</button>
                <button class="flex flex-col items-center gap-1 rounded-md border border-dawn-200 bg-white p-2 text-[10px] font-semibold text-dawn-800" type="button" aria-pressed="false" data-background-color="#ffffff"><span class="h-5 w-5 rounded-full border border-dawn-300 bg-white"></span>White</button>
                <button class="flex flex-col items-center gap-1 rounded-md border border-dawn-200 bg-white p-2 text-[10px] font-semibold text-dawn-800" type="button" aria-pressed="false" data-background-color="#000000"><span class="h-5 w-5 rounded-full border border-dawn-300 bg-black"></span>Black</button>
                <button class="flex flex-col items-center gap-1 rounded-md border border-dawn-200 bg-white p-2 text-[10px] font-semibold text-dawn-800" type="button" aria-pressed="false" data-background-color="#ff0000"><span class="h-5 w-5 rounded-full border border-dawn-300" style="background-color:#ff0000"></span>Red</button>
                <button class="flex flex-col items-center gap-1 rounded-md border border-dawn-200 bg-white p-2 text-[10px] font-semibold text-dawn-800" type="button" aria-pressed="false" data-background-color="#008000"><span class="h-5 w-5 rounded-full border border-dawn-300" style="background-color:#008000"></span>Green</button>
              </div>
            </div>
            <div class="hidden gap-2 border-t border-dawn-200 pt-3" data-background-crop-actions><button class="btn-dark w-full rounded-md px-2 py-2 text-xs" type="button" data-background-crop-apply>Apply crop</button><button class="btn-outline-dark w-full rounded-md px-2 py-2 text-xs" type="button" data-background-crop-cancel>Cancel</button></div>
          </aside>
          </div>
        </section>
        <div class="pointer-events-none fixed z-[60] hidden" data-background-brush-preview aria-hidden="true">
          <canvas class="block rounded-full shadow-xl ring-2 ring-dawn-950/70 outline outline-2 outline-white -outline-offset-2" width="144" height="144" data-background-brush-preview-canvas></canvas>
        </div>
        </div>

        <p class="text-sm text-red-700" role="alert" aria-live="polite" data-background-error></p>
        <p class="flex items-start gap-2 text-xs leading-5 text-red-700" role="note"><span class="warning-icon-x mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full border border-red-700 text-[10px] font-bold" aria-hidden="true">!</span><span><strong>Privacy:</strong> Your image and result stay in this browser on your device, survive refreshes, and are cleared after 30 minutes or when you clear them.</span></p>
      </div>
    </div>
  </section>

  <div class="fixed inset-0 z-50 hidden place-items-center bg-dawn-950/60 p-4" role="alertdialog" aria-modal="true" aria-labelledby="background-dialog-title" aria-describedby="background-dialog-message" data-background-dialog>
    <div class="w-full max-w-md rounded-md border border-dawn-200 bg-white p-6 shadow-xl">
      <h2 class="text-xl font-bold text-dawn-950" id="background-dialog-title">Image cannot be processed</h2>
      <p class="mt-3 text-sm leading-6 text-dawn-700" id="background-dialog-message" data-background-dialog-message></p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="btn-gold hidden rounded-md" href="/image-converter" data-background-convert-link>Convert image</a>
        <button class="btn-outline-dark rounded-md" type="button" data-background-dialog-close>Close</button>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/site-footer') %>
<%- include('../partials/whatsapp', { whatsappNumber }) %>
<script type="module" src="/js/remove-background.js"></script>
<%- include('../partials/site-scripts') %>
